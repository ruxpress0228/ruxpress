# Main Proxy backend — docker compose 가 ./back/.env 로 읽습니다.  cp back/.env.example back/.env
# 값이 비어 있으면 application-prod.yml 의 기본값이 쓰입니다. 비밀값은 절대 커밋하지 마세요.

# ── 데이터베이스 (동봉된 MariaDB 컨테이너 기준 기본값; RDS 등 외부 DB 는 host/계정을 바꾸세요)
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=ruxpress
DB_USERNAME=ruxpress
DB_PASSWORD=ruxpress

# ── 인증 (32자 이상의 무작위 문자열로 반드시 교체)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRATION=604800000

# ── 파일 저장소: local(컨테이너 디스크) 또는 s3
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── 메일 (회원가입 인증·비밀번호 재설정). 비워 두면 메일 기능만 동작하지 않습니다.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_VERIFICATION_SUBJECT=Main Proxy 이메일 인증
MAIL_PASSWORD_RESET_SUBJECT=Main Proxy 비밀번호 재설정

# ── 도메인
FRONTEND_BASE_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000

# ── 푸시 (Kafka 는 compose 가 넣어 줍니다. 푸시를 쓰지 않으면 false)
RUXPRESS_KAFKA_PUBLISH=true
RUXPRESS_KAFKA_CONSUME_RESULTS=true
