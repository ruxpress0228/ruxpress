# Copy to `env` in this directory (script/aws/env) and fill in values.
# Do not commit `env` — it is listed in .gitignore.
#
# Linux/macOS (Git Bash):  script/aws/linux/run-all.sh   (or 01–03, 00 separately)
# Windows (PowerShell):    script/aws/windows/Run-All.ps1

# --- Common ---
AWS_REGION=ap-northeast-2
# Optional: AWS_PROFILE=my-profile

# --- S3 (01) ---
S3_BUCKET_NAME=your-globally-unique-bucket-name

# --- IAM S3 user (02) ---
IAM_USER_NAME=ruxpress-s3-app
# Inline policy name (must be unique per user if re-run after delete)
IAM_S3_POLICY_NAME=RuxpressS3BucketAccess

# --- RDS MySQL (03) ---
DB_INSTANCE_IDENTIFIER=ruxpress-mysql
DB_INSTANCE_CLASS=db.t4g.micro
ALLOCATED_STORAGE=20
MYSQL_ENGINE_VERSION=8.0.40
DB_SUBNET_GROUP_NAME=ruxpress-db-subnet
# Comma-separated, e.g. sg-0123456789abcdef0,sg-0fedcba9876543210
VPC_SECURITY_GROUP_IDS=
MASTER_USERNAME=admin
MASTER_USER_PASSWORD=
# false recommended (requires SG rules + private network path)
RDS_PUBLICLY_ACCESSIBLE=false
# gp2 or gp3
STORAGE_TYPE=gp3
BACKUP_RETENTION_DAYS=7
# set true to wait for RDS to become available before printing endpoint
WAIT_FOR_RDS=false

# --- Default VPC subnet group (00) ---
# Leave empty to use the account default VPC
DEFAULT_VPC_ID=
